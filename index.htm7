post.className = "post";

      post.innerHTML = `
        <h3>New User</h3>
        <p>${text}</p>
        <button class="like" onclick="likePost(this)">
          👍 Like
        </button>
      `;

      document.getElementById("posts").prepend(post);

      document.getElementById("postText").value = "";
    }

    function likePost(button) {
      button.innerHTML = "❤️ Liked";
    }
  </script>

</body>
</html>
